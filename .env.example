# Names only. Never put real values in this file.

# Public, build-time or browser: web
# All unset = fixture mode (noindex, dev images). PUBLIC_SITE_ENV: production | preview. See docs/WEB.md.
PUBLIC_SNAPSHOT_URL=
PUBLIC_IMG_BASE_URL=
PUBLIC_SITE_ENV=
# Admin origin allowed to read /_publish.json (CORS). One exact https origin; unset = no CORS header.
PUBLIC_ADMIN_ORIGIN=

# Public, build-time or browser: admin
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
VITE_IMG_BASE_URL=
# VITE_BACKEND: real (default) or fake (in-memory, tests and autopilot only)
VITE_BACKEND=
VITE_PUBLIC_SITE_URL=
VITE_R2_UPLOAD_ORIGIN=

# Worker plain vars, non-secret
SUPABASE_URL=
SUPABASE_ANON_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_BACKUP_BUCKET=
R2_PUBLIC_BASE_URL=
ALLOWED_ORIGINS=

# WORKER SECRETS, set with wrangler secret put, never in a file
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# PAGES_DEPLOY_HOOK_URL=
