# Names only. Never put real values in this file.

# Public, build-time or browser: web
# All unset = fixture mode (noindex, dev images). PUBLIC_SITE_ENV: production | preview. See docs/WEB.md.
PUBLIC_SNAPSHOT_URL=
PUBLIC_IMG_BASE_URL=
PUBLIC_SITE_ENV=
# Admin origin allowed to read /_publish.json (CORS). One exact https origin; unset = no CORS header.
PUBLIC_ADMIN_ORIGIN=

# Public, build-time or browser: admin (all six URLs/keys required in real mode; the URLs also form the CSP; docs/ADMIN.md)
# Supabase project URL and the anon (publishable) key, never the service-role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# API Worker origin
VITE_API_BASE_URL=
# Public photo host
VITE_IMG_BASE_URL=
# VITE_BACKEND: real (default) or fake (in-memory, tests and autopilot only, never production)
VITE_BACKEND=
# Public site origin (admin reads /_publish.json there)
VITE_PUBLIC_SITE_URL=
# Origin of the presigned R2 upload URLs
VITE_R2_UPLOAD_ORIGIN=

# Worker plain vars, non-secret
SUPABASE_URL=
SUPABASE_ANON_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_BACKUP_BUCKET=
R2_PUBLIC_BASE_URL=
ALLOWED_ORIGINS=

# Legacy migration script (npm run migrate-legacy, docs/MIGRATION.md). Read at run time only, never stored.
# Also uses SUPABASE_URL, SUPABASE_ANON_KEY and PUBLIC_IMG_BASE_URL from above, plus the Worker origin:
API_BASE_URL=
# The second admin account, never the photographer's password
MIGRATE_ADMIN_EMAIL=
MIGRATE_ADMIN_PASSWORD=
# Optional: an admin access token if the password grant is blocked by TOTP
MIGRATE_ACCESS_TOKEN=

# WORKER SECRETS, set with wrangler secret put, never in a file
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# PAGES_DEPLOY_HOOK_URL=
