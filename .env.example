# Names only. Never put real values in this file.
# Every name appears once, under the class it belongs to, with a one-line comment (who sets it, where).
# The gate env-example-complete keeps this list equal to the names the production code reads (docs/GATES.md).

# ---------------------------------------------------------------------------------------------------------------
# 1. Web build (Cloudflare Pages project of apps/web, or the local shell). Public, build-time. docs/WEB.md
# All unset = fixture mode (noindex, dev images).
# Snapshot URL the web build reads; you set it in the Pages project settings.
PUBLIC_SNAPSHOT_URL=
# Public photo host (same host as the Worker R2_PUBLIC_BASE_URL); you set it in the Pages project settings.
PUBLIC_IMG_BASE_URL=
# production or preview; you set it per Pages environment.
PUBLIC_SITE_ENV=
# Admin origin allowed to read /_publish.json (CORS), one exact https origin; unset = no CORS header; Pages settings.
PUBLIC_ADMIN_ORIGIN=
# Cloudflare Web Analytics token (public value), production builds only; unset = no beacon; Pages settings.
PUBLIC_CF_ANALYTICS_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# 2. Admin build (Cloudflare Pages project of apps/admin). Public, baked into the bundle. docs/ADMIN.md
# Five URLs plus the anon key, all required in real mode; the URLs also form the CSP.
# Supabase project URL; you set it in the admin Pages project settings.
VITE_SUPABASE_URL=
# Supabase anon (publishable) key, never the service-role key; admin Pages project settings.
VITE_SUPABASE_ANON_KEY=
# API Worker origin; admin Pages project settings.
VITE_API_BASE_URL=
# Public photo host; admin Pages project settings.
VITE_IMG_BASE_URL=
# Public site origin (the admin reads /_publish.json there); admin Pages project settings.
VITE_PUBLIC_SITE_URL=
# Origin of the presigned R2 upload URLs; admin Pages project settings.
VITE_R2_UPLOAD_ORIGIN=
# real (default, leave unset) or fake (in-memory); set by the check scripts and tests, never in production.
VITE_BACKEND=

# ---------------------------------------------------------------------------------------------------------------
# 3. Worker plain vars, non-secret (Cloudflare dashboard or wrangler vars, never in wrangler.toml). docs/DEPLOY-API.md
# Supabase project URL; set in the Worker settings.
SUPABASE_URL=
# Supabase anon (publishable) key; set in the Worker settings.
SUPABASE_ANON_KEY=
# Cloudflare account id used for the R2 endpoint; set in the Worker settings.
R2_ACCOUNT_ID=
# Name of the public photo bucket (served at the image host); set in the Worker settings.
R2_BUCKET=
# Public photo host the variants are served from; set in the Worker settings.
R2_PUBLIC_BASE_URL=
# Comma-separated exact admin origins allowed by CORS; set in the Worker settings.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------------------------------------------
# 4. Worker secrets, set with wrangler secret put, never in a file (commented on purpose)
# R2 access key id for presigned URLs; you set it with wrangler secret put.
# R2_ACCESS_KEY_ID=
# R2 secret access key for presigned URLs; you set it with wrangler secret put.
# R2_SECRET_ACCESS_KEY=
# Cloudflare Pages deploy hook the publish step calls; you set it with wrangler secret put.
# PAGES_DEPLOY_HOOK_URL=

# ---------------------------------------------------------------------------------------------------------------
# 5. Migrate script, run on your own machine (npm run migrate-legacy, docs/MIGRATION.md)
# Read at run time only, never stored. They also use SUPABASE_URL, SUPABASE_ANON_KEY and PUBLIC_IMG_BASE_URL above.
# Origin of the deployed Worker; you export it in your shell for the run.
API_BASE_URL=
# Access token of a signed-in admin session (lives about one hour, see docs/MIGRATION.md); you export it in your shell for the run.
MIGRATE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# 6. Optional check tooling (design-check, admin-check and the other Chrome checks). All commented: leave unset.
# The checks find Chrome themselves. Never put variables before a command (no env X=1 npm run ...).
# Path to a Chrome binary if the usual locations fail; read by scripts/design-check.mjs and the other browser checks.
# CHROME_PATH=
# Tests only: simulates a machine without Chrome (no well-known path is tried); read by scripts/design-check.mjs.
# DESIGN_CHECK_NO_FALLBACK=
# docs-only: read only by scripts/admin-check.test.mjs (browser mutation test, see docs/ADMIN.md), not by production code
# ADMIN_CHECK_BROWSER=
# docs-only: read only by scripts/admin-encode-check.test.mjs (browser mutation test, see docs/ADMIN.md), not by production code
# ADMIN_ENCODE_BROWSER=
