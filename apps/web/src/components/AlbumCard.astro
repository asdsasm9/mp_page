---
// Album card (a list item): 4/5 cover, meta kicker (place, photo count with the Czech plural), uppercase title.
// Used on category pages and /portfolio/. All the markup and styles are in CategoryCard.
import type { CategoryCard as AlbumCardData } from '../lib/category';
import CategoryCard from './CategoryCard.astro';

interface Props {
  card: AlbumCardData;
  /** Image base URL, e.g. env.imgBaseUrl. */
  base: string;
}

const { card, base } = Astro.props;
const meta = [card.place, card.countLabel].filter(Boolean).join(' · ');
---
<CategoryCard
  href={card.path}
  title={card.title}
  meta={meta}
  photo={card.photo}
  base={base}
  crop="album"
  eager={card.eager}
  priority={card.priority}
/>
