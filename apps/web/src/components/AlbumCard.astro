---
// Album card (a list item): cover via Photo, title, place, photo count. Used on category pages and /portfolio/.
import type { CategoryCard } from '../lib/category';
import Photo from './Photo.astro';

interface Props {
  card: CategoryCard;
  /** Image base URL, e.g. env.imgBaseUrl. */
  base: string;
}

const { card, base } = Astro.props;
---
<li>
  <a href={card.path}>
    <span class="cover">
      <Photo photo={card.photo} base={base} alt="" context="card" eager={card.eager} priority={card.priority} />
    </span>
    <span class="card-title">{card.title}</span>
    <span class="card-meta">
      {card.place && <span>{card.place}</span>}
      <span>{card.countLabel}</span>
    </span>
  </a>
</li>

<style>
  a {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
  }

  /* Uniform cover box: every card has the same shape, so a portrait cover cannot make its row tall and leave a hole.
     The cover is cropped (top-weighted); the whole photo is in the album page. */
  .cover :global(img) {
    aspect-ratio: var(--ratio-card);
    block-size: auto;
    object-fit: cover;
    object-position: var(--cover-position);
  }

  .card-title {
    font-size: var(--font-size-1);
    letter-spacing: var(--tracking-heading);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: var(--space-1);
  }

  a:hover .card-title {
    text-decoration-thickness: var(--bar-thickness);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
</style>
