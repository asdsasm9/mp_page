---
// Grid of category cards (home Portfolio section, /portfolio/). From 48rem the tracks are at most --track-category-max
// (22rem, 1.1 times the album track --track-album-max, T-328) and the group is centred: two columns (a lone last card is
// centred under them, no half-empty ragged row) and three columns from 80rem, where three tracks fit. Below the track
// maximum the tracks shrink to the free width, which is still at least an album track at 48rem. The cover `sizes`
// (images.ts CROP_BASE.category) use the same 22rem. On phones one full-width column.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<ul class:list={['cards', className]}>
  <slot />
</ul>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    align-items: start;
    gap: var(--grid-row-gap) var(--grid-col-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, var(--track-category-max)));
      justify-content: center;
    }

    /* an odd last card sits centred under the two columns, one track wide */
    .cards > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
      justify-self: center;
      inline-size: calc((100% - var(--grid-col-gap)) / 2);
      max-inline-size: var(--track-category-max);
    }
  }

  @media (min-width: 80rem) {
    .cards {
      grid-template-columns: repeat(auto-fit, var(--track-category-max)); /* 3 tracks fit from 80rem; fewer cards collapse the empty ones */
    }

    .cards > :global(:last-child:nth-child(odd)) {
      grid-column: auto;
      justify-self: stretch;
      inline-size: auto;
      max-inline-size: none;
    }
  }
</style>
