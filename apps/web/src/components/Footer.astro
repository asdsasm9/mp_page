---
import { FOOTER, INSTAGRAM_HANDLE, INSTAGRAM_URL, MAIL_ADDRESS, MAIL_URL, MYWED_URL } from '../content/texts';
---
<footer class="site-footer t-small">
  <div class="inner">
    <div class="identity">
      <p class="brand t-h3">{FOOTER.brand}</p>
      <p class="region">{FOOTER.region}</p>
    </div>
    <ul class="contacts" aria-label="Kontakt">
      <li>
        <a class="icon-link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label={`Instagram ${INSTAGRAM_HANDLE} (otevře se v novém okně)`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
          </svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={MAIL_URL} aria-label={`E-mail ${MAIL_ADDRESS}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </a>
      </li>
    </ul>
    <ul class="links">
      <li><a class="text-link" href={MYWED_URL} target="_blank" rel="noopener noreferrer">MyWed</a></li>
      <li><a class="text-link" href="/cookies/">Cookies a soukromí</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-7);
    background: var(--color-surface);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .inner {
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding: var(--space-4) var(--layout-gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .identity {
    flex: 1 1 14rem;
    display: grid;
    gap: var(--space-1);
  }

  .brand,
  .region {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contacts {
    gap: var(--space-2);
  }

  a {
    text-decoration: none;
    border-block-end: var(--border-width) solid transparent;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-compact);
  }

  .text-link:hover,
  .text-link:focus-visible {
    border-block-end-color: var(--color-border-strong);
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-border-strong);
  }
</style>
