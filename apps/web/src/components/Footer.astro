---
// Footer (WP-12 e): hairline on top, copyright and tagline, icon links (Instagram, MyWed, e-mail; no other
// network is rendered because no URL exists), the category names as links and the legal link (T-253). In flow, never fixed (T-226).
import { FOOTER, INSTAGRAM_HANDLE, INSTAGRAM_URL, MAIL_ADDRESS, MAIL_URL, MYWED_URL } from '../content/texts';
import Icon from './Icon.astro';

interface Props {
  categories: ReadonlyArray<{ name: string; slug: string }>;
}

const { categories } = Astro.props;
---
<footer class="site-footer t-small">
  <div class="inner">
    <div class="identity">
      <p class="brand">{FOOTER.copyright}</p>
      <p class="region">{FOOTER.region}</p>
    </div>
    <ul class="contacts" aria-label="Kontakt">
      <li>
        <a class="icon-link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label={`Instagram ${INSTAGRAM_HANDLE} (otevře se v novém okně)`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
          </svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={MYWED_URL} target="_blank" rel="noopener noreferrer" aria-label="MyWed (otevře se v novém okně)">
          <Icon name="mywed" />
        </a>
      </li>
      <li>
        <a class="icon-link" href={MAIL_URL} aria-label={`E-mail ${MAIL_ADDRESS}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </a>
      </li>
    </ul>
    <nav class="categories" aria-label="Kategorie">
      <ul>
        {categories.map((c) => <li><a class="text-link" href={`/${c.slug}/`}>{c.name}</a></li>)}
      </ul>
    </nav>
    <p class="legal"><a class="text-link" href="/cookies/">Cookies a soukromí</a></p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding: var(--space-5) var(--layout-gutter);
  }

  .identity {
    display: grid;
    gap: var(--space-1);
  }

  .brand,
  .region,
  .legal {
    margin: 0;
  }

  .brand {
    color: var(--color-text);
  }

  .region {
    color: var(--color-text-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contacts {
    gap: var(--space-2);
  }

  a {
    text-decoration: none;
    border-block-end: var(--border-width) solid transparent;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-compact);
  }

  .text-link:hover,
  .text-link:focus-visible {
    color: var(--color-accent-text);
    border-block-end-color: var(--color-accent-text);
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    color: var(--color-accent-text);
    border-color: var(--color-accent-strong);
  }
</style>
