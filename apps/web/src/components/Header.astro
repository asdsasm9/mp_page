---
// Sticky header: logo link and a flat nav. Below the wide breakpoint the nav is a native <details>
// disclosure (works without JavaScript); menu.ts only adds Escape and close-on-navigation.
import logo from '../assets/site/common/main_logo_2.png';
import { Image } from 'astro:assets';

import type { NavItem } from '../lib/nav';

interface Props {
  items: readonly NavItem[];
  /** Path of the current page, e.g. `/svatby/sedlakovi/`. */
  current: string;
}

const { items, current } = Astro.props;
// A link is "current" on its own page; on a deeper page (album) the category link is a section marker only.
const isCurrent = (path: string): boolean => current === path;
const isSection = (path: string): boolean => path !== '/' && current !== path && current.startsWith(path);
---
<header class="site-header">
  <div class="bar">
    <a
      class="logo"
      href="/"
      aria-label="Mullny Photos – úvodní stránka"
      aria-current={isCurrent('/') ? 'page' : undefined}
    >
      <Image src={logo} alt="" width={151} height={60} loading="eager" format="webp" />
    </a>
    <details class="menu" data-menu>
      <summary class="menu-toggle">
        <span class="visually-hidden">Menu</span>
        <span class="bars" aria-hidden="true"></span>
      </summary>
      <nav aria-label="Hlavní navigace">
        <ul>
          {
            items.map((item) => (
              <li>
                <a
                  href={item.path}
                  aria-current={isCurrent(item.path) ? 'page' : undefined}
                  data-section={isSection(item.path) ? '' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    background: var(--color-bg);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-inline-size: var(--layout-max);
    min-block-size: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
  }

  .logo :global(img) {
    inline-size: auto;
    block-size: var(--space-7);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    inline-size: var(--space-5);
    block-size: var(--focus-offset);
    background: var(--color-text);
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .bars::before {
    inset-block-start: calc(-1 * var(--space-2));
  }

  .bars::after {
    inset-block-start: var(--space-2);
  }

  nav {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    background: var(--color-bg);
    border-block-end: var(--border-width) solid var(--color-border);
    padding: var(--space-2) var(--layout-gutter) var(--space-4);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-min);
    padding-inline: var(--space-2);
    text-decoration: none;
  }

  nav a:hover {
    background: var(--color-surface);
  }

  nav a[aria-current='page'] {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  nav a[data-section] {
    text-decoration: underline;
    text-decoration-thickness: var(--focus-offset);
    text-underline-offset: var(--space-1);
  }

  @media (min-width: 60em) {
    nav {
      position: static;
      border: 0;
      padding: 0;
      background: transparent;
    }

    ul {
      display: flex;
      gap: var(--space-1);
    }

    nav a {
      border-radius: var(--radius-md);
    }

    /* Where the disclosure content can be forced visible, hide the toggle and show the nav inline. */
    @supports selector(::details-content) {
      .menu::details-content {
        content-visibility: visible;
        display: contents;
      }

      .menu-toggle {
        display: none;
      }
    }
  }
</style>
