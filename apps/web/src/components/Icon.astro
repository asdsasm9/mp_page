const solid = name === 'mywed';
---
{solid ? (
  <svg
    class:list={['icon', 'icon-solid', className]}
    viewBox="24 0 152 161"
    width="22"
    height="23"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    {MYWED_PATHS.map((d) => <path d={d}></path>)}
  </svg>
) : (
  <svg
    class:list={['icon', className]}
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d={PATHS[name]}></path>
  </svg>
)}

<style>
  .icon {
    flex: none;
    inline-size: 1.25em;
    block-size: 1.25em;
  }

  /* Filled mark: about the optical weight of the 24px stroke icons (hexagon fills its box, so slightly smaller). */
  .icon-solid {
    inline-size: 1.375rem;
    block-size: auto;
    aspect-ratio: 152 / 161;
  }
</style>
