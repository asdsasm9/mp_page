---
// Wrapper for a photo that is shown as a print on a mat (the O mně front photo; WP-12 D-22: the only use).
// A mat is a plain border in the page colour. There is NO colour filter, ever: no sepia, saturate, contrast
// or other `filter` on photos (the design file's .plate filter was dropped on purpose). Cards and album tiles stay plain.
interface Props {
  /** Draw the mat. Without it the plate is a plain block (no border, no shadow). */
  matted?: boolean;
  class?: string;
}

const { matted = true, class: className } = Astro.props;
---
<div class:list={['plate', className]} data-matted={matted ? '' : undefined}>
  <slot />
</div>

<style>
  .plate {
    display: block;
    overflow: hidden;
  }

  .plate[data-matted] {
    border: var(--space-3) solid var(--color-bg);
    box-shadow: var(--shadow-md);
  }

  .plate :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
</style>
