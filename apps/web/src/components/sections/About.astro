---
// O mně on the home (WP-12 e): a collage of two photos (hands in wheat behind, the kiss on the forehead in front; both plain, no mat, border or shadow (T-295)),
// the greeting text and a "Více o mně" link to the /o-mne/ page (T-293), which holds the long texts and the quote.
// Both images are lazy (below the hero).
import { Image } from 'astro:assets';
import { HOME } from '../../content/texts';
import Kicker from '../Kicker.astro';
import hello from '../../assets/site/home/hello.jpg';
import wedding from '../../assets/site/about/wedding.jpg';
---
<section id="o-mne" class="about fill fill-tall" aria-labelledby="o-mne-nadpis">
  <div class="inner">
    <div class="overlap">
      <div class="shot back">
        <Image
          src={hello}
          alt="Ruce novomanželů s prsteny v pšeničném poli"
          widths={[480, 960]}
          sizes="(min-width: 48rem) 20rem, 60vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="shot front">
        <Image
          src={wedding}
          alt="Ženich líbá nevěstu na čelo, nevěsta drží kytici z kapradí a trav"
          widths={[480, 960]}
          sizes="(min-width: 48rem) 20rem, 60vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <div class="text" lang="cs">
      <Kicker>O mně</Kicker>
      <h2 id="o-mne-nadpis" class="t-title">{HOME.hello.title}</h2>
      {HOME.hello.paragraphs.map((p) => <p class="t-prose">{p}</p>)}
      <div class="actions">
        <a class="btn" href="/o-mne/">Více o mně</a>
        <a class="btn-ghost" href="#kontakt">Napsat mi</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-pad);
    background: var(--color-surface);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18.75rem, 100%), 1fr));
    gap: var(--section-gap-lg);
    align-items: center;
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  /* Back photo top-left, front photo overlapping at the bottom-right. Both photos keep their native
     aspect ratio (from the width/height the image carries), so nothing is cropped and the box grows with
     them (T-318). No colour filter on photos, no radius. */
  .overlap {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    inline-size: 100%;
    max-inline-size: 32.5rem;
    justify-self: center;
  }

  .shot :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .back {
    grid-area: 1 / 1 / 2 / 8;
  }

  /* Percent margins resolve against the grid area width, so the overlap scales with the box. */
  .front {
    grid-area: 2 / 5 / 3 / 13;
    margin-block-start: -35%;
    z-index: 1;
  }

  .text {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .text p {
    hyphens: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
</style>
