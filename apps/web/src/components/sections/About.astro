---
// O mně (WP-12 e): a collage of two photos (hands in wheat behind, the kiss on the forehead in front on a mat),
// the greeting text, and a native <details> "Více o mně" with the rest of the old About page and the long quote,
// so no real text is lost and no JavaScript is needed. Both images are lazy (below the hero).
import { Image } from 'astro:assets';
import { ABOUT, HOME } from '../../content/texts';
import Kicker from '../Kicker.astro';
import Plate from '../Plate.astro';
import hello from '../../assets/site/home/hello.jpg';
import wedding from '../../assets/site/about/wedding.jpg';

const more = [ABOUT.me, ABOUT.experience, ABOUT.story];
---
<section id="o-mne" class="about" aria-labelledby="o-mne-nadpis">
  <div class="inner">
    <div class="plates">
      <Plate matted={false} class="back">
        <Image
          src={hello}
          alt="Ruce novomanželů s prsteny v pšeničném poli"
          widths={[480, 960]}
          sizes="(min-width: 48rem) 20rem, 60vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </Plate>
      <Plate class="front">
        <Image
          src={wedding}
          alt="Ženich líbá nevěstu na čelo, nevěsta drží kytici z kapradí a trav"
          widths={[480, 960]}
          sizes="(min-width: 48rem) 20rem, 60vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </Plate>
    </div>
    <div class="text" lang="cs">
      <Kicker>O mně</Kicker>
      <h2 id="o-mne-nadpis" class="t-title">{HOME.hello.title}</h2>
      {HOME.hello.paragraphs.map((p) => <p class="t-prose">{p}</p>)}
      <details class="more">
        <summary class="btn">Více o mně</summary>
        <div class="more-body">
          {
            more.map((block) => (
              <>
                <h3>{block.title}</h3>
                <p class="t-prose">{block.body}</p>
              </>
            ))
          }
          <blockquote class="t-prose">{HOME.quote}</blockquote>
        </div>
      </details>
      <a class="btn-ghost" href="#kontakt">Napsat mi</a>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-pad);
    background: var(--color-surface);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18.75rem, 100%), 1fr));
    gap: var(--section-gap-lg);
    align-items: center;
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  /* Back plate top-left, front plate overlapping at the bottom-right; the box keeps its own aspect ratio */
  .plates {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(12, 1fr);
    aspect-ratio: 1 / 1.05;
    inline-size: 100%;
    max-inline-size: 32.5rem;
    justify-self: center;
  }

  .plates :global(.back) {
    grid-area: 1 / 1 / 9 / 8;
  }

  .plates :global(.front) {
    grid-area: 6 / 5 / 13 / 13;
    z-index: 1;
  }

  .text {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .text p {
    hyphens: auto;
  }

  .more {
    display: grid;
    gap: var(--space-4);
    inline-size: 100%;
  }

  .more summary {
    justify-self: start;
    list-style: none;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more-body {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
  }

  .more-body blockquote {
    margin: 0;
    padding-inline-start: var(--space-5);
    border-inline-start: var(--border-width) solid var(--color-accent);
    max-inline-size: var(--measure);
    hyphens: auto;
  }
</style>
