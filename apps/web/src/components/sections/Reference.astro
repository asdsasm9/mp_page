---
// Reference (WP-12 e, T-278): the client reviews on the dark band. Server HTML: every review as a slide, the first one
// marked active. Without JavaScript (`@media (scripting: none)`) all slides are stacked and the arrows and counter are
// hidden; with it the slides share one grid cell (the band is as tall as the tallest slide, nothing shifts) and
// scripts/reference-carousel.ts moves the active marker. No autoplay. The slide shows the full review text (T-320).
// Zero reviews renders nothing; one review renders no arrows and no counter.
// T-333 (D-25): the author's portrait (the review album's cover) sits to the right of the text from 48rem, below it on
// phones; it is after the text in the DOM and lives inside the slide, so it changes with the slide. No cover, no photo, no gap.
import type { HomeReview } from '../../lib/home';
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import Section from '../Section.astro';

interface Props {
  reviews: readonly HomeReview[];
  /** Image base URL, e.g. env.imgBaseUrl. */
  base: string;
}

const { reviews, base } = Astro.props;
const total = reviews.length;
---
{
  total > 0 && (
    <Section id="reference" class="fill fill-tall"title="Reference" band="dark">
      <div class="carousel" data-carousel role="region" aria-roledescription="carousel" aria-label="Recenze klientů">
        <div class="viewport" data-viewport>
          {reviews.map(({ review, categoryName, photo }, i) => (
            <div
              class="slide"
              data-slide
              data-active={i === 0 ? '' : undefined}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} z ${total}`}
            >
              <figure class:list={{ 'has-photo': photo }}>
                <blockquote class="t-quote">
                  <p>{review.text}</p>
                </blockquote>
                <figcaption class="t-kicker">{categoryName ? `${review.name} · ${categoryName}` : review.name}</figcaption>
                {photo && (
                  <div class="portrait">
                    <Photo photo={photo} base={base} alt={`${review.name}, klientka`} crop="profile" />
                  </div>
                )}
              </figure>
            </div>
          ))}
        </div>
        {
          total > 1 && (
            <div class="controls" data-controls>
              <button type="button" class="arrow" data-prev aria-label="Předchozí reference">
                <Icon name="chevron-left" />
              </button>
              <p class="count t-kicker" data-counter>
                1 / {total}
              </p>
              <button type="button" class="arrow" data-next aria-label="Další reference">
                <Icon name="chevron-right" />
              </button>
            </div>
          )
        }
      </div>
    </Section>
  )
}

<script>
  import '../../scripts/reference-carousel';
</script>

<style>
  .carousel {
    display: grid;
    gap: var(--space-5);
  }

  .viewport {
    display: grid;
    gap: var(--space-7);
  }

  /* T-336: every slide is as tall as the tallest one (shared grid cell, below) and its content is centred in that
     height, so a shorter review neither moves the content nor the switcher */
  .slide {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
  }

  .slide figure {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin: 0;
  }

  .slide blockquote {
    margin: 0;
  }

  .slide figcaption {
    color: var(--band-dark-muted);
  }

  .portrait {
    inline-size: var(--profile-size-compact);
  }

  /* Phones: text block, caption and portrait stacked, each centred as a block (quote lines stay left-aligned) */
  .slide figure.has-photo {
    justify-items: center;
  }

  .slide figure.has-photo blockquote,
  .slide figure.has-photo figcaption {
    justify-self: center;
    max-inline-size: 36rem;
  }

  .slide figure.has-photo figcaption {
    text-align: center;
  }

  .slide figure.has-photo .portrait {
    margin-block-start: var(--space-3);
  }

  /* Two columns (T-335): portrait left, text right (the DOM keeps the text first), centred together as one group,
     vertically centred against each other */
  @media (min-width: 48rem) {
    .slide figure.has-photo {
      grid-template-columns: auto minmax(0, 36rem);
      grid-template-areas:
        'portrait quote'
        'portrait caption';
      justify-content: center;
      align-content: center;
      align-items: center;
      column-gap: var(--space-6);
    }

    .slide figure.has-photo .portrait {
      margin-block-start: 0;
    }

    .slide figure.has-photo blockquote {
      grid-area: quote;
      align-self: end;
    }

    .slide figure.has-photo figcaption {
      grid-area: caption;
      align-self: start;
      justify-self: start;
      text-align: start;
      max-inline-size: none;
    }

    .slide figure.has-photo blockquote {
      justify-self: stretch;
      max-inline-size: none;
    }

    .portrait {
      grid-area: portrait;
      inline-size: var(--profile-size);
    }
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .count {
    margin: 0;
    min-inline-size: 4ch;
    text-align: center;
    color: var(--band-dark-muted);
    font-variant-numeric: tabular-nums;
  }

  .arrow {
    display: inline-grid;
    place-items: center;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    padding: 0;
    border: var(--border-width) solid color-mix(in srgb, var(--band-dark-text) 40%, transparent);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--band-dark-text);
    cursor: pointer;
    transition:
      color var(--motion-fast) var(--motion-ease),
      border-color var(--motion-fast) var(--motion-ease);
  }

  .arrow:hover {
    color: var(--band-dark-accent);
    border-color: var(--band-dark-accent);
  }

  /* No scripting: all reviews stacked, nothing to operate */
  @media (scripting: none) {
    .controls {
      display: none;
    }
  }

  /* Scripting: one slide at a time, all in the same grid cell so the band keeps the height of the tallest one */
  @media (scripting: enabled) {
    .viewport {
      gap: 0;
      touch-action: pan-y;
    }

    .slide {
      grid-area: 1 / 1;
      visibility: hidden;
      opacity: 0;
    }

    .slide[data-active] {
      visibility: visible;
      opacity: 1;
    }
  }

  /* Print: nothing to operate, every review on paper (after the scripting rules so it wins) */
  @media print {
    .controls {
      display: none;
    }

    .viewport {
      gap: var(--space-5);
    }

    .viewport .slide {
      grid-area: auto;
      visibility: visible;
      opacity: 1;
      transition: none;
    }
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .slide {
      transition:
        opacity var(--motion-drawer) var(--motion-ease),
        visibility var(--motion-drawer) var(--motion-ease);
    }
  }
</style>
