---
// Page shell: head (all tags from seo.ts), skip link, header, the single <main>, footer.
// JSON-LD goes through serializeJsonLd only; it is the one allowed use of set:html besides the hash script.
import Analytics from '../components/Analytics.astro';
import Fonts from '../components/Fonts.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { buildNav, type NavItem } from '../lib/nav';
import { NAV } from '../content/texts';
import { getCatalog } from '../lib/catalog';
import { readRawEnv, resolveEnv } from '../lib/env';
import { pageUrl, serializeJsonLd, type JsonLd } from '../lib/jsonld';
import { BRAND, type PageMeta } from '../lib/seo';
import tokensCss from '../styles/tokens.css?raw';
import '../styles/tokens.css';
import '../styles/base.css';

export interface OgImage {
  /** Absolute URL. */
  readonly url: string;
  readonly width: number;
  readonly height: number;
  readonly alt: string;
  /** MIME type (OgImage.type in lib/images.ts). Every og image on this site is a JPEG, which is the default. */
  readonly type?: string;
}

interface Props {
  meta: PageMeta;
  /** Path of this page with leading and trailing slash, e.g. `/svatby/`. Canonical is built from it. */
  path: string;
  ogImage?: OgImage;
  jsonLd?: readonly JsonLd[];
  /** True only where the page starts with a full-bleed hero that the header overlays (the home page). */
  heroHeader?: boolean;
}

const { meta, path, ogImage, jsonLd = [], heroHeader = false } = Astro.props;
const env = resolveEnv(readRawEnv());
const catalog = await getCatalog(env);
const canonical = pageUrl(path);
const noindex = env.noindex || meta.noindex;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const themeColor = /--color-theme:\s*([^;]+);/.exec(tokensCss)?.[1]?.trim();

// Header items: the same from every page.
const navItems: NavItem[] = buildNav(NAV);
const categoryNames = catalog.categories.map((c) => c.name);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={meta.ogTitle} />
    {meta.description && <meta property="og:description" content={meta.description} />}
    <meta property="og:url" content={canonical} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage.url} />
          {/* secure_url and type help scrapers (Facebook, WhatsApp, LinkedIn) that ask for them explicitly */}
          {ogImage.url.startsWith('https://') && <meta property="og:image:secure_url" content={ogImage.url} />}
          <meta property="og:image:type" content={ogImage.type ?? 'image/jpeg'} />
          <meta property="og:image:width" content={String(ogImage.width)} />
          <meta property="og:image:height" content={String(ogImage.height)} />
          <meta property="og:image:alt" content={ogImage.alt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={meta.ogTitle} />
    {meta.description && <meta name="twitter:description" content={meta.description} />}
    {ogImage && <meta name="twitter:image" content={ogImage.url} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImage.alt} />}

    <Fonts />
    <slot name="head" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
    <Analytics token={env.analyticsToken} />
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <Header items={navItems} current={path} categoryNames={categoryNames} overHero={heroHeader} />
    <main id="obsah" tabindex="-1">
      <slot />
    </main>
    <Footer categories={catalog.categories.map((c) => ({ name: c.name, slug: c.slug }))} />
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
