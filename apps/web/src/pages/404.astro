---
// 404 (built to dist/404.html). noindex comes from notFoundMeta(); Base also forces it per environment.
import PageHead from '../components/PageHead.astro';
import { NOT_FOUND } from '../content/texts';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/catalog';
import { readRawEnv, resolveEnv } from '../lib/env';
import { notFoundMeta } from '../lib/seo';

const catalog = await getCatalog(resolveEnv(readRawEnv()));
const crumbs = [{ name: NOT_FOUND.title, path: '/404/' }];
---
<Base meta={notFoundMeta()} path="/404/">
  <div class="page">
    <PageHead crumbs={crumbs} title={NOT_FOUND.title}>
      <p class="t-lead">{NOT_FOUND.body}</p>
    </PageHead>
    <p class="actions">
      <a class="btn" href="/">Na úvodní stránku</a>
    </p>
    <ul class="categories" aria-label="Portfolio">
      {catalog.categories.map((c) => <li><a class="btn-ghost" href={`/${c.slug}/`}>{c.name}</a></li>)}
    </ul>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding: var(--space-4) var(--layout-gutter) var(--space-7);
  }

  .actions {
    margin: 0;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
