---
// Album page: header (title, place, date, description), breadcrumb, photo grid, previous/next album, lightbox.
// Each thumbnail is a link to the 1600 JPEG, so the grid works without JavaScript; lightbox.ts upgrades it
// to a native <dialog>. The data-lb-* attributes (fit srcset, master URL and size) are read only by the zoom script.
import AlbumGrid from '../../../components/AlbumGrid.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import { ctaLabel } from '../../../content/texts';
import Base from '../../../layouts/Base.astro';
import { albumThumbs, formatShotOn } from '../../../lib/album';
import { getCatalog } from '../../../lib/catalog';
import { readRawEnv, resolveEnv } from '../../../lib/env';
import { ogImage as photoOgImage } from '../../../lib/images';
import { albumGallery, albumPath, breadcrumbList } from '../../../lib/jsonld';
import { albumMeta } from '../../../lib/seo';

export async function getStaticPaths() {
  const catalog = await getCatalog(resolveEnv(readRawEnv()));
  return catalog.categories.flatMap((category) =>
    category.albums
      .filter((album) => album.photos.length > 0)
      .map((album) => ({ params: { category: category.slug, album: album.slug } })),
  );
}

const env = resolveEnv(readRawEnv());
const catalog = await getCatalog(env);
const category = catalog.categoryBySlug.get(Astro.params.category!)!;
const album = catalog.albumBySlug.get(Astro.params.album!)!.album;
const path = albumPath(category, album);
const meta = albumMeta(category, album);
const thumbs = albumThumbs(category, album);
const cover = catalog.coverOf(album);
const og = cover ? photoOgImage(cover, env.imgBaseUrl) : null;
const crumbs = [
  { name: category.name, path: `/${category.slug}/` },
  { name: album.title, path },
];
const date = formatShotOn(album.shotOn);
const kicker = [album.place, date].filter(Boolean).join(' · ');
const description = album.description?.trim() || null;
const { prev, next } = catalog.neighbours(album.slug);
---
<Base
  meta={meta}
  path={path}
  ogImage={og ? { url: og.url, width: og.width, height: og.height, alt: album.title } : undefined}
  jsonLd={[albumGallery(category, album, meta.description ?? '', env.imgBaseUrl), breadcrumbList(crumbs)]}
>
  <div class="page">
    <PageHead crumbs={crumbs} title={album.title} kicker={kicker || undefined} backHref={`/${category.slug}/`} backLabel={category.name}>
      {description && <p class="t-body description">{description}</p>}
    </PageHead>

    <AlbumGrid thumbs={thumbs} base={env.imgBaseUrl} />

    <nav class="album-nav t-small" aria-label="Další alba">
      {
        prev ? (
          <a class="prev" rel="prev" href={albumPath(category, prev)}>
            <Icon name="arrow-left" />
            {prev.title}
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <a class="next" rel="next" href={albumPath(category, next)}>
            {next.title}
            <Icon name="arrow-right" />
          </a>
        ) : (
          <span></span>
        )
      }
    </nav>

    <p class="cta">
      <a class="btn" href="/#kontakt">{ctaLabel(category.slug)}</a>
    </p>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Prohlížeč fotografií">
    <div class="lb-stage" data-lb="stage">
      <img class="lb-back" data-lb="back" alt="" hidden />
      <img class="lb-front" data-lb="img" alt="" />
    </div>
    <p class="count t-caption" data-lb="count" aria-live="polite"></p>
    <p class="lb-status t-caption" data-lb="status" role="status" aria-live="polite"></p>
    <p class="lb-level" data-lb="level" role="status" aria-live="polite"></p>
    <div class="lb-zoom" data-lb="zoom" role="group" aria-label="Přiblížení" hidden>
      <button type="button" class="lb-btn t-body" data-lb="zoom-out" aria-label="Oddálit">&minus;</button>
      <button type="button" class="lb-btn t-body" data-lb="zoom-fit" aria-label="Přizpůsobit 1×">1&times;</button>
      <button type="button" class="lb-btn t-body" data-lb="zoom-in" aria-label="Přiblížit">+</button>
    </div>
    <button type="button" class="lb-btn t-h3 lb-close" data-lb="close" aria-label="Zavřít">&times;</button>
    <button type="button" class="lb-btn t-h3 lb-prev" data-lb="prev" aria-label="Předchozí fotografie">&lsaquo;</button>
    <button type="button" class="lb-btn t-h3 lb-next" data-lb="next" aria-label="Další fotografie">&rsaquo;</button>
  </dialog>
</Base>

<script>
  import '../../../scripts/lightbox';
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding: var(--space-4) var(--layout-gutter) var(--space-7);
  }

  .description {
    margin: 0;
  }

  /* Quiet previous/next row between two hairlines' worth of space: one top hairline, links in muted text. */
  .album-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .album-nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .album-nav a:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: var(--space-1);
  }

  .cta {
    display: flex;
    justify-content: center;
    max-inline-size: none; /* base.css limits paragraphs to the text measure; the CTA is centred on the full width */
    margin: var(--space-4) 0 0;
  }

  /* Lightbox: full-viewport modal dialog on the overlay colour. */
  .lightbox {
    inline-size: 100%;
    max-inline-size: none;
    block-size: var(--lb-h, 100dvh);
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-overlay);
    color: var(--color-on-overlay);
    z-index: var(--z-dialog);
    /* The whole dialog (stage AND controls) refuses the browser's pinch zoom of the page and its panning: the
       photo zoom is ours. A page pinch from a touch that began on a button or the counter used to zoom the page,
       push the close button off screen and, because the stage then refused pinch-out, leave no way back (T-291). */
    touch-action: none;
  }

  /* Safety net: if the page is zoomed anyway (iOS), lightbox.ts sets data-page-zoomed and these vars; the dialog
     is re-fitted to the visible window (size of the layout viewport, moved to the visual viewport, scaled back to
     1:1) so close, prev/next, counter and zoom buttons stay on screen, and the browser may pinch back out. */
  .lightbox[data-page-zoomed] {
    inline-size: var(--lb-w);
    transform: translate(var(--lb-vx), var(--lb-vy)) scale(var(--lb-vs));
    transform-origin: 0 0;
    touch-action: pinch-zoom;
  }

  .lightbox[data-page-zoomed] .lb-stage {
    touch-action: pinch-zoom;
  }

  /* Block, not grid: the absolutely positioned controls must be placed against the dialog's own box
     (in a grid they used a grid area and the counter and zoom group drifted off the viewport centre). */
  .lightbox[open] {
    display: block;
    overflow: hidden;
  }

  .lightbox [hidden] {
    display: none;
  }

  /* Zoom area: both images share one grid cell; the front one is shown over the back (grid thumbnail) one. */
  .lb-stage {
    display: grid;
    grid-template: 100% / 100%;
    place-items: center;
    inline-size: 100%;
    block-size: var(--lb-h, 100dvh);
    overflow: hidden;
    /* The stage is its own scroll container, so it needs the value itself (the dialog's does not reach it). */
    touch-action: none;
  }

  .lb-stage img {
    grid-area: 1 / 1;
    display: block;
    /* Both layers fill the stage and contain the photo, so the thumbnail and the sharper image sit exactly
       on each other and the swap does not move anything; the script measures this box for the zoom limits. */
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    transform: translate(var(--lb-x, 0), var(--lb-y, 0)) scale(var(--lb-scale, 1));
  }

  .lb-stage[data-zoom='on'] img {
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lb-stage[data-zoom='on'][data-zoomed] {
    cursor: grab;
  }

  .lb-status {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline: var(--space-8);
    margin: 0;
    text-align: center;
  }

  .lb-status:empty {
    display: none;
  }

  /* Zoom level announcement for screen readers only; it never takes focus. */
  .lb-level {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Zoom buttons: the button alternative to pinch, double tap, wheel and drag (WCAG 2.5.1, 2.5.7). */
  .lb-zoom {
    position: absolute;
    inset-block-end: max(var(--space-3), env(safe-area-inset-bottom));
    inset-inline-start: 50%;
    z-index: 1;
    translate: -50% 0;
    display: flex;
    gap: var(--space-2);
  }

  .lb-zoom .lb-btn {
    position: static;
  }

  /* Top row mirrors the close button: counter at the start, close at the end, both centred on the same line. */
  .count {
    position: absolute;
    inset-block-start: max(var(--space-3), env(safe-area-inset-top));
    inset-inline-start: max(var(--space-3), env(safe-area-inset-left));
    z-index: 1;
    display: inline-flex;
    align-items: center;
    block-size: var(--target-min);
    margin: 0;
    padding-inline: var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-overlay);
  }

  .lb-btn {
    position: absolute;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: var(--border-width) solid var(--color-on-overlay);
    border-radius: var(--radius-full);
    background: var(--color-overlay);
    color: var(--color-on-overlay);
    cursor: pointer;
  }

  .lb-btn:disabled,
  .lb-btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }

  .lb-btn:focus-visible {
    outline: var(--focus-width) solid var(--color-focus-on-dark);
    outline-offset: var(--focus-offset);
  }

  /* Controls sit outside the transformed images, above them, and clear of notches and home bars. */
  .lb-close {
    inset-block-start: max(var(--space-3), env(safe-area-inset-top));
    inset-inline-end: max(var(--space-3), env(safe-area-inset-right));
    z-index: 1;
  }

  .lb-prev,
  .lb-next {
    inset-block-start: 50%;
    translate: 0 -50%;
  }

  .lb-prev,
  .lb-next {
    z-index: 1;
  }

  .lb-prev {
    inset-inline-start: max(var(--space-3), env(safe-area-inset-left));
  }

  .lb-next {
    inset-inline-end: max(var(--space-3), env(safe-area-inset-right));
  }

  @media (prefers-reduced-motion: reduce) {
    .lb-stage img {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lb-stage img {
      transition: transform var(--motion-fast) var(--motion-ease);
    }

    /* Fingers or a drag move the image directly; the transition would make it lag behind. */
    .lb-stage[data-gesture] img {
      transition: none;
    }

    .lightbox[open] {
      animation: lb-in var(--motion-base) var(--motion-ease);
    }

    @keyframes lb-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
