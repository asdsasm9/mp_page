---
// Home one-pager (WP-12 e): hero (the LCP image), O mně, Portfolio, Reference (if any reviews), Kontakt.
// Anchors: uvod, o-mne, portfolio, reference, kontakt. Only the hero image is eager with fetchpriority="high".
import { Image, getImage } from 'astro:assets';
import CategoryCard from '../components/CategoryCard.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import Photo from '../components/Photo.astro';
import Section from '../components/Section.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Hero from '../components/sections/Hero.astro';
import Reference from '../components/sections/Reference.astro';
import { REVIEWS } from '../content/reviews';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/catalog';
import { readRawEnv, resolveEnv } from '../lib/env';
import { HASH_REDIRECT_SCRIPT } from '../lib/hash-redirect';
import { homeCategoryCards, homeHero, homeReviews } from '../lib/home';
import { SITE_ORIGIN, person, photographerFull, website } from '../lib/jsonld';
import { homeMeta } from '../lib/seo';
import hero from '../assets/site/home/main.jpg';

const env = resolveEnv(readRawEnv());
const catalog = await getCatalog(env);
const meta = homeMeta();
const cards = homeCategoryCards(catalog);
const reviews = homeReviews(catalog, REVIEWS);

const heroAlt = 'Mullny Photos – párové a svatební focení v Brně';
// The photo chosen in the admin (T-285), else null and the bundled main.jpg below.
const chosenHero = homeHero(catalog, heroAlt, env.imgBaseUrl);
const ogImage = chosenHero
  ? {
      ...chosenHero.og,
      // Fixture mode serves images from a relative /_dev-img; og:image must be absolute either way.
      url: /^https?:\/\//.test(chosenHero.og.url) ? chosenHero.og.url : `${SITE_ORIGIN}${chosenHero.og.url}`,
      alt: chosenHero.alt,
    }
  : await getImage({ src: hero, width: 1200, height: 630, format: 'jpg' }).then((og) => ({
      url: `${SITE_ORIGIN}${og.src}`,
      width: 1200,
      height: 630,
      alt: heroAlt,
    }));
---
<Base meta={meta} path="/" ogImage={ogImage} heroHeader jsonLd={[photographerFull(ogImage.url), website(), person(ogImage.url)]}>
  <!-- Must be inline to run before first paint; T-67's CSP gets its sha256 from the postbuild. -->
  <script is:inline slot="head" set:html={HASH_REDIRECT_SCRIPT} />
  <Hero categoryNames={catalog.categories.map((c) => c.name)}>
    {
      chosenHero ? (
        <Photo slot="image" photo={chosenHero.photo} base={env.imgBaseUrl} alt={chosenHero.alt} context="hero" priority />
      ) : (
        <Image
          slot="image"
          src={hero}
          alt={heroAlt}
          widths={[480, 960, 1600]}
          sizes="100vw"
          format="webp"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )
    }
  </Hero>

  <About />

  {
    cards.length > 0 && (
      <Section id="portfolio" title="Portfolio" actionHref="/portfolio/" actionLabel="Celé portfolio">
        <CategoryGrid>
          {cards.map((card) => (
            <CategoryCard href={card.path} title={card.name} meta={card.countLabel} photo={card.photo} base={env.imgBaseUrl} />
          ))}
        </CategoryGrid>
      </Section>
    )
  }

  <Reference reviews={reviews} />

  <Contact />
</Base>
