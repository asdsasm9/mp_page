---
// About (T-293, rebuilt in T-319 with the WP-12 system only). Alternating bands as on the home:
//   ground  - PageHead (breadcrumb, h1, hairline) with the first text as the lead;
//   surface - "Mé zkušenosti" and "Můj příběh" (h2 at the h3 token size) beside the two photos; the first photo's top is the
//             top of the first heading; on phones the photos follow the first text block, full width, natural aspect ratio;
//   dark    - the long quote as t-quote (Section, band="dark");
//   ground  - the closing link to the home Kontakt section.
// JSON-LD: Person (worksFor #business) and BreadcrumbList. Both photos are lazy: the page has no hero.
import { Image, getImage } from 'astro:assets';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import { ABOUT, HOME, NAV } from '../../content/texts';
import Base from '../../layouts/Base.astro';
import { SITE_ORIGIN, breadcrumbList, person } from '../../lib/jsonld';
import { aboutMeta } from '../../lib/seo';
import hello from '../../assets/site/home/hello.jpg';
import wedding from '../../assets/site/about/wedding.jpg';

const path = '/o-mne/';
const meta = aboutMeta();
const crumbs = [{ name: NAV.about, path }];

const weddingAlt = 'Ženich líbá nevěstu na čelo, nevěsta drží kytici z kapradí a trav';
const og = await getImage({ src: wedding, width: 1200, height: 630, format: 'jpg', quality: 70 });
const ogImage = { url: `${SITE_ORIGIN}${og.src}`, width: 1200, height: 630, alt: weddingAlt };
---
<Base meta={meta} path={path} ogImage={ogImage} jsonLd={[person(ogImage.url), breadcrumbList(crumbs)]}>
  <div class="band" data-band="ground">
    <div class="inner">
      <PageHead crumbs={crumbs} title={NAV.about}>
        <p class="t-lead" lang="cs">{ABOUT.me.body}</p>
      </PageHead>
    </div>
  </div>

  <div class="band" data-band="surface">
    <div class="inner layout" lang="cs">
      <section class="text experience" aria-labelledby="zkusenosti">
        <h2 id="zkusenosti" class="t-h3">{ABOUT.experience.title}</h2>
        <p class="t-prose">{ABOUT.experience.body}</p>
      </section>
      <div class="photos">
        <Image
          src={hello}
          alt="Ruce novomanželů s prsteny v pšeničném poli"
          widths={[480, 960]}
          sizes="(min-width: 48rem) 30rem, 100vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
        <Image
          src={wedding}
          alt={weddingAlt}
          widths={[480, 960]}
          sizes="(min-width: 48rem) 30rem, 100vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
      <section class="text story" aria-labelledby="pribeh">
        <h2 id="pribeh" class="t-h3">{ABOUT.story.title}</h2>
        <p class="t-prose">{ABOUT.story.body}</p>
      </section>
    </div>
  </div>

  <Section id="vzpominky" title="Vzpomínky" band="dark" size="h3">
    <blockquote class="t-quote" lang="cs">{HOME.quote}</blockquote>
  </Section>

  <div class="band" data-band="ground">
    <div class="inner closing">
      <a class="btn" href="/#kontakt">Napište mi</a>
    </div>
  </div>
</Base>

<style>
  .band {
    padding-block: var(--section-pad);
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* The head band sits right under the header: only its bottom padding is the section rhythm */
  .band:first-child {
    padding-block-start: var(--space-4);
  }

  .band[data-band='surface'] {
    background: var(--color-surface);
  }

  .inner {
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  /* Phones: experience, photos, story. From 48rem: texts left, both photos right, level with the first heading */
  .layout {
    display: grid;
    gap: var(--section-gap);
    align-items: start;
  }

  .text {
    display: grid;
    gap: var(--space-4);
  }

  /* Short accent stroke under each sub-head (decoration only) */
  .text h2 {
    margin: 0;
    padding-block-end: var(--space-3);
  }

  .text h2::after {
    content: '';
    display: block;
    inline-size: var(--space-6);
    margin-block-start: var(--space-3);
    border-block-start: var(--border-width) solid var(--color-accent);
  }

  .text p {
    max-inline-size: var(--measure);
    hyphens: auto;
  }

  .photos {
    display: grid;
    gap: var(--space-5);
  }

  .photos :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    background: var(--color-placeholder);
  }

  #vzpominky blockquote {
    max-inline-size: var(--measure);
    margin: 0;
    hyphens: auto;
  }

  .closing {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 48rem) {
    .layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--section-gap-lg);
    }

    .experience {
      grid-area: 1 / 1;
    }

    .story {
      grid-area: 2 / 1;
    }

    .photos {
      grid-area: 1 / 2 / 3 / 3;
      /* On wide screens the photos stay a modest column, so they do not tower over the texts */
      inline-size: 100%;
      max-inline-size: 28rem;
      justify-self: end;
    }
  }
</style>
