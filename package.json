{
  "name": "mullnyphotos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "build": "npm run build -w apps/web -w apps/admin",
    "gates": "node scripts/gates.mjs",
    "bench:snapshot": "tsx scripts/bench-snapshot.ts",
    "check:site": "npm run build -w apps/web && node scripts/site-checks.mjs",
    "design-check": "node scripts/design-check.mjs",
    "heading-check": "node scripts/heading-check.mjs",
    "image-fit":"node scripts/image-fit.mjs",
    "qa-check": "node scripts/qa-check.mjs",
    "hero-contrast":"node scripts/hero-contrast.mjs",
    "phone-bytes": "node scripts/phone-bytes.mjs",
    "lightbox-network": "node scripts/lightbox-network.mjs",
    "lightbox-a11y": "node scripts/lightbox-a11y.mjs",
    "lightbox-layout": "node scripts/lightbox-layout.mjs",
    "admin-encode-check": "node scripts/admin-encode-check.mjs",
    "admin-check": "node scripts/admin-check.mjs",
    "admin-prod-check": "node scripts/admin-prod-check.mjs",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "site-images:import": "node scripts/site-images-import.mjs",
    "dev-images": "tsx scripts/dev-images.ts",
    "photo-quality": "tsx scripts/photo-quality-measure.ts",
    "migrate-legacy": "tsx scripts/migrate-legacy.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "puppeteer-core": "25.14.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
