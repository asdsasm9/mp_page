{
  "name": "mullnyphotos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w apps/web -w apps/admin",
    "gates": "node scripts/gates.mjs",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "site-images:import": "node scripts/site-images-import.mjs",
    "dev-images": "tsx scripts/dev-images.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
