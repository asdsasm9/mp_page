{
  "_note": "Authority: this file is the machine-readable form of the approved MASTERPLAN architecture (section 3 and decision D-2). Changing it needs an architect-approved decision recorded in DECISIONS.md, not a builder edit to make a gate green. Keep it small. It holds names and shapes only, never secrets or secret-shaped strings.",
  "components": {
    "rootWorkspaces": ["apps/*", "packages/*"],
    "directories": ["apps/web", "apps/admin", "apps/api", "packages/shared", "supabase/migrations", "scripts", "docs"],
    "requiredDeps": {
      "apps/web": ["astro", "@mp/shared"],
