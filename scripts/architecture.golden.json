  },
  "dataModel": {
    "tables": ["admins", "categories", "albums", "photos", "url_history", "app_config", "site_state", "publish_log", "upload_reservations", "keepalive"],
    "columns": {
      "categories": ["id", "slug", "name", "description", "seo_title", "seo_description", "sort", "visible"],
      "albums": ["id", "category_id", "slug", "title", "place", "shot_on", "description", "seo_title", "seo_description", "cover_photo_id", "sort", "published", "legacy_id"],
      "photos": ["id", "album_id", "master_key", "width", "height", "variants", "bytes_total", "dominant_color", "alt", "caption", "sort", "legacy_key"]
    },
    "appConfigDefaults": {
      "quota_hard_bytes": 9500000000,
      "quota_warn_bytes": 8000000000,
      "max_upload_bytes": 41943040,
      "max_files_per_batch": 200,
      "reservation_ttl_min": 60
    },
    "photoWriteFunctions": ["register_photo", "delete_photos"],
    "anonExecute": ["keepalive"],
    "functions": {
