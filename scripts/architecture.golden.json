      "albums_slug_history": { "revokeFrom": ["public", "anon", "authenticated"], "grantTo": [] },
      "categories_slug_history": { "revokeFrom": ["public", "anon", "authenticated"], "grantTo": [] },
      "albums_delete_history": { "revokeFrom": ["public", "anon", "authenticated"], "grantTo": [] },
      "is_admin": { "revokeFrom": ["public", "anon"], "grantTo": ["authenticated"] },
      "storage_usage": { "revokeFrom": ["public", "anon"], "grantTo": ["authenticated"] },
      "reserve_uploads": { "revokeFrom": ["public", "anon"], "grantTo": ["authenticated"] },
      "register_photo": { "revokeFrom": ["public", "anon"], "grantTo": ["authenticated"] },
      "delete_photos": { "revokeFrom": ["public", "anon"], "grantTo": ["authenticated"] },
      "request_publish": { "revokeFrom": ["public", "anon"], "grantTo": ["authenticated"] },
      "record_publish": { "revokeFrom": ["public", "anon"], "grantTo": ["authenticated"] },
      "keepalive": { "revokeFrom": ["public"], "grantTo": ["anon", "authenticated"] }
    },
    "requiredFiles": [
      "supabase/tests/lint.test.ts",
      "supabase/tests/golden/privilege-matrix.json",
